# Copy to .env and fill in. .env is git-ignored: never commit real values.
# docker compose reads this file automatically.

# --- Machine credentials (never exposed to browsers) ---
ADMIN_API_KEY=change-me-long-random-string      # machine callers of the /admin/* endpoints and scripts
INTERNAL_API_KEY=change-me-long-random-string   # payment / auth service webhooks (X-Service-Key)

# --- coupon-service data stores ---
# Default (leave unset): local Postgres + Redis containers started by docker compose.
# To use hosted free tiers instead, set these:
# COUPON_DATABASE_URL=postgresql://<user>:<password>@<host>/<db>?sslmode=require     # e.g. Neon (direct, non-pooled host)
# COUPON_REDIS_URL=rediss://default:<password>@<name>.upstash.io:6379                # note: rediss:// (TLS)

# --- Offer mapping mode: strict (1:1 coupon type -> offer type) | flexible (any combination) ---
OFFER_MODE=flexible

# --- Ask AI (optional): free key from https://aistudio.google.com/apikey ---
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.5-flash

# --- Only needed when running coupon-service OUTSIDE docker (python -m uvicorn ...) ---
# DATABASE_URL=postgresql://semicon:semicon@localhost:5435/coupons
# REDIS_URL=redis://localhost:6380/0
# NEON_DB_URL=            # if set, takes precedence over DATABASE_URL

